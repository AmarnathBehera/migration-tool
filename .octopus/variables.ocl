variable "Octopus.Azure.Account" {
    type = "AzureAccount"

    value "octopus-npe-gwt-oidc" {
        description = ""
    }

    value "octopus-gwt-prd" {
        description = ""
        environment = ["production"]
    }
}

variable "deploy.octopus.workerPool" {
    type = "WorkerPool"

    value "gwt-npe-worker-pool" {}

    value "gwt-prd-worker-pool" {
        description = ""
        environment = ["production"]
    }
}

variable "appsettings.azureAdClientId" {
    value "7e20a3ed-beed-48cd-91cb-f20f5feffd71" {}
}

variable "appsettings.azureAdTenantId" {
    value "44f4e7a6-4821-44d7-b286-cd90436c6975" {}
}

variable "appsettings.CMSConnectionString" {
    value "Server=bdo-dbs-gwt-xbyk-#{environment.abbreviation}-eur-we.database.windows.net;Database=bdo-db-gwt-xbyk-#{environment.abbreviation}-eur-we;Authentication=Active Directory Managed Identity;TrustServerCertificate=False;Encrypt=True;" {}
}

variable "appsettings.reactAppService" {
    value "https://bdo-web-gwt-xbyk-react-#{environment.abbreviation}-eur-we.azurewebsites.net" {}
}

variable "appsettings.CMSAzureAccountName" {
    value "bdosagwtxbyk#{environment.abbreviation}eurwe" {}
}

variable "appsettings.CMSAzureCDNEndpoint" {
    value "https://bdosagwtxbyk#{environment.abbreviation}eurwe.blob.core.windows.net" {}
}

variable "appsettings.azureAdClientSecret" {
    value "@Microsoft.KeyVault(VaultName=bdo-kv-gwt-xbyk-#{environment.abbreviation}-eur;SecretName=gwt-xbyk-cms-app-secret)" {
        environment = ["development"]
    }
}

variable "appsettings.CMSAzureSharedKey" {
    value "@Microsoft.KeyVault(VaultName=bdo-kv-gwt-xbyk-#{environment.abbreviation}-eur;SecretName=gwt-xbyk-storage-account-shared-key)" {
        environment = ["development"]
    }
}

variable "appsettings.CMSHashStringSalt" {
    value "@Microsoft.KeyVault(VaultName=bdo-kv-gwt-xbyk-#{environment.abbreviation}-eur;SecretName=gwt-xbyk-cms-hashStringSalt)" {
        environment = ["development"]
    }
}