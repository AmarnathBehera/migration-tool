variable "Octopus.Azure.Account" {
    type = "AzureAccount"

    value "octopus-npe-gwt-oidc" {
        description = ""
    }

    value "octopus-gwt-prd" {
        description = ""
        environment = ["production"]
    }
}

variable "deploy.octopus.workerPool" {
    type = "WorkerPool"

    value "gwt-npe-worker-pool" {}

    value "gwt-prd-worker-pool" {
        description = ""
        environment = ["production"]
    }
}

variable "appsettings.azureTenantId" {
    value "44f4e7a6-4821-44d7-b286-cd90436c6975" {}
}

variable "appsettings.CMSConnectionString" {
    value "Server=bdo-dbs-gwt-xbyk-#{environment.abbreviation}-eur-we.database.windows.net;Authentication=Active Directory Managed Identity;TrustServerCertificate=False;Encrypt=True;" {}
}