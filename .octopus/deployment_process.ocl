step "deploy-cms-app-service" {
    name = "Deploy CMS App Service"
    properties = {
        Octopus.Action.TargetRoles = "xbyk-cms-webapp"
    }

    action {
        action_type = "Octopus.AzureAppService"
        properties = {
            Octopus.Action.Azure.AppSettings = <<-EOT
                [
                  {
                    "name": "AzureStorageProviderSettings__CMSAzureCDNEndpoint",
                    "value": "#{appsettings.CMSAzureCDNEndpoint}",
                    "slotSetting": false
                  },
                  {
                    "name": "AzureStorageProviderSettings__CMSAzureAccountName",
                    "value": "#{appsettings.CMSAzureAccountName}",
                    "slotSetting": false
                  },
                  {
                    "name": "AzureStorageProviderSettings__CMSAzureSharedKey",
                    "value": "#{appsettings.CMSAzureSharedKey}",
                    "slotSetting": false
                  },
                  {
                    "name": "AzureStorageProviderSettings__CMSAzureRootContainer",
                    "value": "cmslibrary",
                    "slotSetting": false
                  },
                  {
                    "name": "CMSHashStringSalt",
                    "value": "#{appsettings.CMSHashStringSalt}",
                    "slotSetting": false
                  },  
                  {
                    "name": "BDOSyncApiKey",
                    "value": "#{appsettings.syncApiKey}",
                    "slotSetting": false
                  },
                  {
                    "name": "BDOSyncApiUrl",
                    "value": "#{appsettings.syncApiUrl}",
                    "slotSetting": false
                  },
                  {
                    "name": "AzureAd__TenantId",
                    "value": "#{appsettings.azureAdTenantId}",
                    "slotSetting": false
                  },
                  {
                    "name": "AzureAd__ClientId",
                    "value": "#{appsettings.cmsAppClientId}",
                    "slotSetting": false
                  },
                    {
                    "name": "AzureAd__ClientSecret",
                    "value": "#{appsettings.cmsAppClientSecret}",
                    "slotSetting": false
                  },
                  {
                    "name": "ReactOptions__ServerUrl",
                    "value": "#{appsettings.reactAppService}",
                    "slotSetting": false
                  },
                  {
                    "name": "FallbackSendGridClientOptions__ApiKey",
                    "value": "#{appsettings.FallbackSendGridClientApiKey}",
                    "slotSetting": false
                  },
                  {
                    "name": "SystemSendGridClientOptions__ApiKey",
                    "value": "#{appsettings.SystemSendGridClientApiKey}",
                    "slotSetting": false
                  },
                  {
                    "name": "AdminRedirectOptions__RedirectDomain",
                    "value": "#{appsettings.RedirectDomain}",
                    "slotSetting": false
                  },
                  {
                    "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                    "value": "#{appsettings.appInsightsCMSConnectionString}",
                    "slotSetting": false
                  },
                  {
                    "name": "CMSAzureSearch__SearchServiceEnabled",
                    "value": "true",
                    "slotSetting": false
                  },
                  {
                    "name": "CMSAzureSearch__SearchServiceEndPoint",
                    "value": "#{appsettings.CMSAzureSearchSearchServiceEndPoint}",
                    "slotSetting": false
                  },
                  {
                    "name": "CMSAzureSearch__SearchServiceAdminApiKey",
                    "value": "#{appsettings.CMSAzureSearchSearchServiceAdminApiKey}",
                    "slotSetting": false
                  },
                  {
                    "name": "CMSAzureSearch__SearchServiceQueryApiKey",
                    "value": "#{appsettings.CMSAzureSearchSearchServiceQueryApiKey}",
                    "slotSetting": false
                  },
                  {
                    "name": "AzureCognitiveSearch__ServiceUrl",
                    "value": "#{appsettings.AzureCognitiveSearchServiceUrl}",
                    "slotSetting": false
                  },
                  {
                    "name": "AzureCognitiveSearch__QueryKey",
                    "value": "#{appsettings.AzureCognitiveSearchQueryKey}",
                    "slotSetting": false
                  },
                  {
                    "name": "AzureCognitiveSearch__IndexSuffix",
                    "value": "",
                    "slotSetting": false
                  }
                ]
                EOT
            Octopus.Action.Azure.ConnectionStrings = <<-EOT
                [
                   {
                      "name": "CMSConnectionString",
                      "value": "#{appsettings.CMSConnectionString}",
                      "type": "SQLAzure",
                      "slotSetting": false
                   }
                ]
                EOT
            Octopus.Action.Azure.DeploymentType = "Package"
            Octopus.Action.EnabledFeatures = "Octopus.Features.ConfigurationVariables,Octopus.Features.JsonConfigurationVariables,Octopus.Features.ConfigurationTransforms,Octopus.Features.SubstituteInFiles"
            Octopus.Action.Package.DownloadOnTentacle = "False"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "GWT.XbyK.CMS.Deploy"
            OctopusUseBundledTooling = "False"
        }
        worker_pool_variable = "deploy.octopus.workerPool"

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "GWT.XbyK.CMS.Deploy"
            properties = {
                SelectionMode = "immediate"
            }
        }
    }
}

