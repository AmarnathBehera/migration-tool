step "deploy-api-app-service" {
    name = "Deploy API App Service"
    properties = {
        Octopus.Action.TargetRoles = "xbyk-api-webapp"
    }
    start_trigger = "StartWithPrevious"

    action {
        action_type = "Octopus.AzureAppService"
        properties = {
            Octopus.Action.Azure.AppSettings = <<-EOT
                [
                  {
                    "name": "ASPNETCORE_ENVIRONMENT",
                    "value": "#{appsettings.aspNetCoreEnvironment}",
                    "slotSetting": false
                  },
                  {
                    "name": "AzureAd__Instance",
                    "value": "#{appsettings.azureAdInstance}",
                    "slotSetting": false
