}

step "deploy-sync-app-service" {
  name = "Deploy Sync App Service"
  properties = {
    Octopus.Action.TargetRoles = "xbyk-sync-webapp"
  }
  start_trigger = "StartWithPrevious"

  action {
    action_type = "Octopus.AzureAppService"
    properties = {
      Octopus.Action.Azure.AppSettings = <<-EOT
        [
          {
          "name": "ASPNETCORE_ENVIRONMENT",
          "value": "#{appsettings.aspNetCoreEnvironment}",
          "slotSetting": false
          },
          {
          "name": "SyncApiKey",
          "value": "#{appsettings.syncApiKey}",
          "slotSetting": false
          },
          {
          "name": "Regions__Name",
          "value": "",
          "slotSetting": false
          },
          {
          "name": "Regions__SyncServerUrl",
          "value": "",
          "slotSetting": false
          },
          {
          "name": "GlobalSiteGUID",
          "value": "#{appsettings.syncGlobalSiteGuid}",
          "slotSetting": false
          }
        ]
        EOT
      Octopus.Action.Azure.ConnectionStrings = <<-EOT
        [
           {
            "name": "CMSConnectionString",
            "value": "#{appsettings.CMSConnectionString}",
            "type": "SQLAzure",
            "slotSetting": false
           }
        ]
        EOT
      Octopus.Action.Azure.DeploymentType = "Package"
      Octopus.Action.EnabledFeatures = "Octopus.Features.ConfigurationVariables,Octopus.Features.JsonConfigurationVariables,Octopus.Features.ConfigurationTransforms,Octopus.Features.SubstituteInFiles"
      Octopus.Action.Package.DownloadOnTentacle = "False"
      Octopus.Action.Package.FeedId = "octopus-server-built-in"
      Octopus.Action.Package.PackageId = "GWT.XbyK.Sync.Deploy"
      OctopusUseBundledTooling = "False"
    }
    worker_pool_variable = "deploy.octopus.workerPool"

    packages {
      acquisition_location = "Server"
      feed = "octopus-server-built-in"
      package_id = "GWT.XbyK.Sync.Deploy"
      properties = {
        SelectionMode = "immediate"
      }
    }
  }
}

step "update-apim-api-from-swagger" {
    name = "Update APIM API from Swagger"

    action {
        action_type = "Octopus.AzurePowerShell"
        properties = {
            Octopus.Action.Azure.AccountId = "#{octopus.azure.account}"
            Octopus.Action.Package.DownloadOnTentacle = "False"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "GWT.XbyK.API.Deploy"
            Octopus.Action.Script.ScriptFileName = "Deploy/APIM/Update-ApimApiFromSwagger.ps1"
            Octopus.Action.Script.ScriptSource = "Package"
            OctopusUseBundledTooling = "False"
        }
        worker_pool_variable = "deploy.octopus.workerPool"

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "GWT.XbyK.API.Deploy"
            properties = {
                SelectionMode = "immediate"
            }
        }
    }
}

step "restore-kentico-ci-database" {
    name = "Restore Kentico CI Database"

    action {
        action_type = "Octopus.AzurePowerShell"
        properties = {
            Octopus.Action.Azure.AccountId = "#{octopus.azure.account}"
            Octopus.Action.Package.DownloadOnTentacle = "False"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "GWT.XbyK.CI.Deploy"
            Octopus.Action.Script.ScriptFileName = "Invoke-KenticoCIRestore.ps1"
            Octopus.Action.Script.ScriptSource = "Package"
            OctopusUseBundledTooling = "False"
        }
        worker_pool_variable = "deploy.octopus.workerPool"

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "GWT.XbyK.CI.Deploy"
            properties = {
                SelectionMode = "immediate"
            }
        }
    }
}