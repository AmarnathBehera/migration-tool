<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Product>Xperience by Kentico AzureSearch Search</Product>
		<Title>$(Product)</Title>
		<PackageId>Kentico.Xperience.AzureSearch</PackageId>
		<Description>Enables the creation of AzureSearch search indexes and the indexing of Xperience website channel pages and reusable content items.</Description>
		<RepositoryUrl>https://github.com/kentico/xperience-by-kentico-azure-ai-search</RepositoryUrl>
	</PropertyGroup>

	<PropertyGroup>
		<AdminOrgName>kentico</AdminOrgName>
		<RootNamespace>Kentico.Xperience.AzureSearch</RootNamespace>
		<NoWarn>$(NoWarn);S1075</NoWarn>

		<!-- Required to prevent type conflicts with existing types -->
		<HotChocolateImplicitUsings>disable</HotChocolateImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="CMS.AssemblyDiscoverableAttribute">
		</AssemblyAttribute>
		<InternalsVisibleTo Include="$(AssemblyName).Tests" />

		<!-- Requires that npm run build or npm run build:dev was executed _before_ the .NET build -->
	</ItemGroup>

	<Target Name="NpmInstall" BeforeTargets="NpmBuildClient"
        Inputs="Admin\Client\package.json;Admin\Client\package-lock.json"
        Outputs="Admin\Client\node_modules\.install-stamp">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)\Admin\Client" />
    <Touch Files="Admin\Client\node_modules\.install-stamp" AlwaysCreate="true" />
</Target>

<Target Name="NpmBuildClient" BeforeTargets="BeforeBuild"
        Inputs="@(NpmClientSourceFiles)"
        Outputs="Admin\Client\dist\entry.js">
    <ItemGroup>
        <NpmClientSourceFiles Include="Admin\Client\src\**\*.*;Admin\Client\webpack.config.js;Admin\Client\package.json" />
    </ItemGroup>
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\Admin\Client" />
</Target>

<!-- Always runs, every build, regardless of whether NpmBuildClient's Exec was skipped -->
<Target Name="RegisterAdminClientPath" BeforeTargets="BeforeBuild" AfterTargets="NpmBuildClient">
    <ItemGroup>
        <AdminClientPath Include="Admin\Client\dist\**">
            <ProjectName>xperience-integrations-azuresearch</ProjectName>
        </AdminClientPath>
    </ItemGroup>
</Target>

      

	<ItemGroup>
    <PackageReference Include="Azure.Search.Documents" Version="12.0.0" />
    <PackageReference Include="Kentico.Xperience.Admin" Version="31.7.0" />
    <PackageReference Include="Kentico.Xperience.WebApp" Version="31.7.0" />
</ItemGroup>
</Project>
