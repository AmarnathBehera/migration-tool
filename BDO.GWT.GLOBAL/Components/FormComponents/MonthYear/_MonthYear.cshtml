@using Kentico.Forms.Web.Mvc
@using Kentico.Web.Mvc
@model BDO.GWT.Xperience.Core.LiveSite.Components.FormComponents.MonthYear

@{
    var htmlAttributes = ViewData.Kentico().GetEditorHtmlAttributes();

    if (htmlAttributes.ContainsKey("class"))
    {
        htmlAttributes["class"] = htmlAttributes["class"] + " filled-in";
    }
    else
    {
        htmlAttributes["class"] = "filled-in";
    }
}
<p>
    <label>
        @Html.TextBoxFor(m => m.Month, htmlAttributes)
        @Html.TextBoxFor(m => m.Year, htmlAttributes)    
    </label>
</p>