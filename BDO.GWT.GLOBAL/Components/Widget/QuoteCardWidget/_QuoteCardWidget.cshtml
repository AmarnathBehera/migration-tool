
@using BDO.GWT.Common.Core.LiveSite.Data
@model QuoteCardData

@{
    var data = Model.Data;
}

<style>
    .quote-card {
        padding: 32px;
        background-color: #f7f7f7;
        border-left: 6px solid #1f4fd8;
        margin-top: @(Model.TopMargin)px;
        margin-bottom: @(Model.BottomMargin)px;
        max-width: 900px;
    }

    .quote-card.small {
        max-width: 600px;
    }

    .quote-card.large {
        max-width: 1100px;
    }

    .quote-heading {
        font-size: 24px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .quote-subheading {
        font-size: 16px;
        color: #555;
        margin-bottom: 16px;
    }

    .quote-text {
        font-size: 18px;
        font-style: italic;
        margin-bottom: 20px;
        line-height: 1.6;
    }

    .quote-author {
        font-weight: 600;
    }

    .quote-author-title {
        font-size: 14px;
        color: #666;
    }

    .quote-footer {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-top: 24px;
    }

    .quote-image img {
        width: 64px;
        height: 64px;
        object-fit: cover;
        border-radius: 50%;
    }

    .quote-button a {
        display: inline-block;
        padding: 10px 18px;
        background-color: #1f4fd8;
        color: #fff;
        text-decoration: none;
        font-size: 14px;
        border-radius: 4px;
    }

    .quote-button a:hover {
        background-color: #163bb0;
    }
</style>

<div class="quote-card @(data.Size?.ToLower())" id="@Model.WidgetID">

    @* Heading *@
    @if (!string.IsNullOrWhiteSpace(data.Heading))
    {
        <div class="quote-heading">
            @Html.Raw(data.Heading)
        </div>
    }

    @* Sub Heading *@
    @if (!string.IsNullOrWhiteSpace(data.SubHeading))
    {
        <div class="quote-subheading">
            @Html.Raw(data.SubHeading)
        </div>
    }

    @* Quote Text *@
    @if (!string.IsNullOrWhiteSpace(data.QuoteText))
    {
        <div class="quote-text">
            “@Html.Raw(data.QuoteText)”
        </div>
    }

    <div class="quote-footer">

        @* Image *@
        @if (!string.IsNullOrWhiteSpace(data.ImageURL))
        {
            <div class="quote-image">
                <img src="@data.ImageURL" alt="@data.ImageAltText" />
            </div>
        }

        <div>
            @* Author *@
            @if (!string.IsNullOrWhiteSpace(data.QuotesAuthor))
            {
                <div class="quote-author">
                    @data.QuotesAuthor
                </div>
            }

            @* Author Job Title *@
            @if (!string.IsNullOrWhiteSpace(data.AuthorsJobTitle))
            {
                <div class="quote-author-title">
                    @data.AuthorsJobTitle
                </div>
            }
        </div>
    </div>

    @* Button *@
    @if (data.Button != null && !string.IsNullOrWhiteSpace(data.Button.URL))
    {
        <div class="quote-button" style="margin-top: 24px;">
            <a href="@data.Button.URL" target="@data.Button.Target">
                @data.Button.Title
            </a>
        </div>
    }

</div>
