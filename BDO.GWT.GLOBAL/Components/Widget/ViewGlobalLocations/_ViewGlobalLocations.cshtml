@using BDO.GWT.Web.Core.LiveSite.Data
@model ViewGlobalLocationsData

<section class="global-locations-section @Model.Theme" style="margin-top:@Model.TopMargin; margin-bottom:@Model.BottomMargin;">

    <div class="container text-center">

@* Title *@
@if (!string.IsNullOrEmpty(Model.Title))
{
            <h2 class="section-title">@Model.Title</h2>
}

@* Description *@
@if (!string.IsNullOrEmpty(Model.Description))
{
            <p class="section-description">@Model.Description</p>
}

@* Button *@