@using BDO
@using BDO.GWT.GLOBAL.Services
@using BDO.GWT.Xperience.LiveSite.Components.Section
@using Kentico.PageBuilder.Web.Mvc
@addTagHelper Kentico.Content.Web.Mvc.WidgetZoneTagHelper, Kentico.Content.Web.Mvc
@model Kentico.PageBuilder.Web.Mvc.ComponentViewModel<SectionWithGapProperties>
@inject IPageBuilderSectionService PageBuilderSectionService

@{
    var allowedWidgets = PageBuilderSectionService.GetAllowedWidgets(ComponentIdentifiers.Sections.FourColumns);
}

<div class="section-container @Model.Properties.ContainerPadding">
    <div class="section-container--items section-container--four @Model.Properties.SectionsGap">
        <div>
            <widget-zone allowed-widgets="allowedWidgets" />
        </div>
        <div>
            <widget-zone allowed-widgets="allowedWidgets" />
        </div>
        <div>
            <widget-zone allowed-widgets="allowedWidgets" />
        </div>
        <div>
            <widget-zone allowed-widgets="allowedWidgets" />
        </div>
    </div>
</div>
