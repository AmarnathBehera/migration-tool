          <fielddescriptionashtml>False</fielddescriptionashtml>
        </properties>
        <settings>
          <controlname>Kentico.Administration.Checkbox</controlname>
        </settings>
      </field>
      <field allowempty="true" column="PeopleListFilters" columnprecision="0" columnsize="200" columntype="text" enabled="true" guid="20e79f3e-dbbc-445b-9fd1-71a6671d79bb" visible="true">
        <properties>
          <defaultvalue>credential;businessLine;industryCategory</defaultvalue>
          <explanationtext>
            <![CDATA[Filters that visitor will be able to filter people by.]]>
          </explanationtext>
          <explanationtextashtml>False</explanationtextashtml>
          <fieldcaption>Filters</fieldcaption>
          <fielddescriptionashtml>False</fielddescriptionashtml>
          <includeintranslation>True</includeintranslation>
        </properties>
        <settings>
          <controlname>
            <![CDATA[XperienceCommunity.Multichoiceformcontrol.MultiChoice]]>
          </controlname>
          <Options>
<![CDATA[
credential;Credential
profileGroup;Profile Group
businessLine;Service (Business Line)
serviceArea;Service Area
service;Service
subService;Sub-Service
industryCategory;Industry (Industry Category)
industryPage;Industry
industryService;Industry Service
specialtyCategory;Specialty (Specialty Category)
