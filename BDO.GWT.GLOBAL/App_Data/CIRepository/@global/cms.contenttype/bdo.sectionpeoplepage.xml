specialty;Specialty
micrositeMasterPage;Microsite (Microsite Master Page)
officeLocation;Office (Office Location)
City
]]>
          </Options>
          <OptionsValueSeparator>;</OptionsValueSeparator>
        </settings>
        <visibilityconditiondata>
