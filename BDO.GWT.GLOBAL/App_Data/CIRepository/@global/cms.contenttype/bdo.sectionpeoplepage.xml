        <properties>
          <defaultvalue>True</defaultvalue>
          <explanationtext>
            <![CDATA[If Display Email is not checked, the email will not show]]>
          </explanationtext>
          <explanationtextashtml>False</explanationtextashtml>
          <fieldcaption>Display email address in person page</fieldcaption>
          <fielddescription>
            <![CDATA[If the Display Email option is not selected, the email address will remain hidden. This means the system will not show the email on the page or profile. Only users with the option enabled will have their email visible. This helps control privacy and prevent unwanted exposure. To make the email visible, ensure the Display Email checkbox is checked.]]>
          </fielddescription>
          <fielddescriptionashtml>False</fielddescriptionashtml>
        </properties>
        <settings>
          <controlname>Kentico.Administration.Checkbox</controlname>
        </settings>
      </field>
