@using BDO
@using BDO.GWT.Core.Constants
@using BDO.GWT.Core.Services
@using BDO.GWT.Xperience.LiveSite.Services
@using Kentico.Content.Web.Mvc
@inject IReactService ReactService
@model BDO.GWT.Web.Core.DTOs.Pages.FormPageDto
@inject IWebPageDataContextRetriever WebPageDataContextRetriever

@{
    var pageContext = WebPageDataContextRetriever.Retrieve();
    var pageId = pageContext.WebPage.WebPageItemID;
}
@{
    Layout = "_Layout";


    var widgetsList = new[]
    {
        ComponentIdentifiers.Widgets.ExternalNavigation,
        ComponentIdentifiers.Widgets.Imagewithtext,
        ComponentIdentifiers.Widgets.QuoteCard,
        ComponentIdentifiers.Widgets.TiledLink,
        ComponentIdentifiers.Widgets.Globallocation
    };
}

@(await ReactService.RenderComponentAsync(
    pageId,
    ReactComponentType.Hero,
    ReactComponentType.HeroGUID,
    new
    {
       data = Model.Hero,
    }, Context.RequestAborted))



<div class="section-container section-container--items section-container--two-thirds gap--xl py-20">
    <div class="contact-form-container">
        @* @ReactHelper.RenderComponent(Html, "ContactPageDescriptionText", Model) *@

        @if (Model.FormType != null && Model.FormType == "embedCode")
        {
            @Html.Raw(Model.EmbedCode)
        }

    </div>
    <div>
        @* @await PageBuilderService.AddIdentifier("topArea").AddWidgets(widgetsList).BuildEditableAreaAsync(Html) *@
    </div>
</div>

@* @await PageBuilderService.AddIdentifier("bottomArea").AddWidgets(widgetsList).BuildEditableAreaAsync(Html)

@PageBuilderService.GetPageBuilderScripts(Html) *@