@using BDO
@using Kentico.Content.Web.Mvc
@using Kentico.PageBuilder.Web.Mvc
@using BDO.GWT.Common.Core.LiveSite.Data
@using BDO.GWT.Core.Constants
@using BDO.GWT.Core.Services
@using CMS.Websites
@model BDO.GWT.Core.DTOs.HomeDto
@inject IPageBuilderService PageBuilderService

@inject IReactService ReactService
@inject IWebPageDataContextRetriever WebPageDataContextRetriever

@{
    var pageContext = WebPageDataContextRetriever.Retrieve();
    var pageId = pageContext.WebPage.WebPageItemID;
}
@{
    Layout = "_Layout";


    var widgetsList = new[]
    {
        ComponentIdentifiers.Widgets.ExternalNavigation,
        ComponentIdentifiers.Widgets.Imagewithtext,
        ComponentIdentifiers.Widgets.QuoteCard,
        ComponentIdentifiers.Widgets.TiledLink,
        ComponentIdentifiers.Widgets.Globallocation,
        ComponentIdentifiers.Widgets.LocalNavigation,
        ComponentIdentifiers.Widgets.KeyTakeaways
    };
}




    @if (Model != null && pageId != 0)
    {
        @(await ReactService.RenderComponentAsync(
        pageId,
        ReactComponentType.HomeHero,
        ReactComponentType.HomeHeroGUID,
        new {
        homeHero = Model.HomeHeroSlides,

        },
        Context.RequestAborted))
    }

<div class="elevated">
    @if (Model != null && pageId != 0)
    {
        @(await ReactService.RenderComponentAsync(
        pageId,
        ReactComponentType.TrendingTopics,
        ReactComponentType.TrendingTopicsGUID,
        new {
        data = Model.TrendingTopics
        },
        Context.RequestAborted))
    }

    @PageBuilderService.GetPageBuilderStyles(Html)

    @await Html.Kentico().EditableAreaAsync(
        "mainContent",
        new EditableAreaOptions
        {
            AllowedWidgets = widgetsList
        })
</div>