@model BDO.GWT.Core.DTOs.HomeDto
@using BDO
@using Kentico.Content.Web.Mvc
@using Kentico.PageBuilder.Web.Mvc

@{
    Layout = "_Layout";

    
    var widgetsList = new[]
    {
        ComponentIdentifiers.ExternalNavigation,
        ComponentIdentifiers.Imagewithtext,
        ComponentIdentifiers.QuoteCard,
        ComponentIdentifiers.TiledLink,
        ComponentIdentifiers.Globallocation
    };
}

@if (Model != null)
{
    <h2>@Model.MetaData.MetaTitle</h2>
}

<div>
    @if (Model?.HomeHeroSlides?.Any() == true)
    {
        var firstSlide = Model.HomeHeroSlides.FirstOrDefault();
        if (!string.IsNullOrEmpty(firstSlide?.MobileImageURL))
        {
            <img src="@Url.Content(firstSlide.MobileImageURL)" alt="@(firstSlide.MobileImageAltText ?? "Hero image")" />
            <img src="@Url.Content(firstSlide.ImageURL)" alt="@(firstSlide.ImageAltText ?? "Image image")" />
            <img src="@Url.Content(firstSlide.ThumbnailImageURL)" alt="@(firstSlide.ThumbnailImageAltText ?? "Thumbnail image")" />
        }
    }
</div>

<div>
  
    @await Html.Kentico().EditableAreaAsync(
    "mainContent", // Unique identifier
        new EditableAreaOptions
        {
          
            AllowedWidgets = widgetsList
        })
</div>