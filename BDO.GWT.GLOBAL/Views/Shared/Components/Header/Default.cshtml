@using BDO.GWT.Common.Core.LiveSite.Data
@using BDO.GWT.Core.Constants
@using BDO.GWT.Core.Services
@using CMS.Websites
@using CMS.Core
@using Kentico.Content.Web.Mvc
@model BDO.GWT.Core.DTOs.Header.HeaderDto
@inject IReactService ReactService
@inject IEventLoggingXbyK EventLoggingXbyK
 

@inject IWebPageDataContextRetriever WebPageDataContextRetriever

@{
    var pageId = (int?)ViewData["PageId"] ?? 0;
    if (pageId == 0){
        try
        {
            var pageContext = WebPageDataContextRetriever.Retrieve();
            pageId = pageContext.WebPage.WebPageItemID;
        }
        catch (InvalidOperationException)
        {
            EventLogData data = new EventLogData(EventTypeEnum.Information,"Header Component","HEADER_PAGE_CONTEXT_MISSING")
            {
                EventDescription = "Header rendered without Kentico web page context.",
                EventUrl = Context?.Request?.Path.Value
            };
            EventLoggingXbyK.LogEvent(data);
        
        }
    }
}

@if (Model != null && pageId != 0)
{
    @(await ReactService.RenderComponentAsync(
        pageId,
        ReactComponentType.Header,
        ReactComponentType.HeaderGUID,
        new {
        headerDetails = Model,
    },
        Context.RequestAborted))
}