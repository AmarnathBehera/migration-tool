@model BDO.GWT.Core.DTOs.Header.HeaderDto

<!-- ============================= -->
<!-- HEADER -->
<!-- ============================= -->
<header class="site-header">

    <!-- ===== TOP MENU ===== -->
    <div class="top-menu">

        <!-- Left Menu -->
        <ul class="top-menu-links">
            @foreach (var item in Model.MenuItems)
            {
                <li>
                    <a href="@item.URL" target="@item.Target">
                        @item.Title
                    </a>
                </li>
            }
        </ul>

        <!-- Right Menu -->
        <div class="top-menu-right">
            <div class="culture-switcher">
                <ul class="culture-list">
                    @foreach (var culture in Model.Cultures)
                    {
                        <li>
                            <a href="@culture.Url" title="@culture.Name">
                                @culture.ShortName
                            </a>
                        </li>
                    }
                </ul>
            </div>
            @if (Model.Contact != null)
            {
                <div class="contact">
                    <a href="@Model.Contact.URL" class="contact-btn">
                        @Model.Contact.Title
                    </a>
                </div>
            }

        </div>

    </div>


    <!-- ===== LOGO + SEARCH ===== -->
    <div class="logo-search">
        <div class="logo">
            <img src="https://cdn.bdo.global/images/bdo_logo/1.0.0/bdo_logo_color.png"
                 alt="BDO Logo">
            <span>Norge</span>
        </div>
        <div class="search-box">
            <input type="text" placeholder="Søk">
        </div>
    </div>
</header>


<!-- ============================= -->
<!-- MEGA MENU -->
<!-- ============================= -->
@if (Model.MegaMenuItems != null && Model.MegaMenuItems.Any())
{
    <div class="mega-menu-wrapper">

        <ul class="mega-main">

            @foreach (var first in Model.MegaMenuItems)
            {
                <li class="mega-parent">

                    <a href="@first.URL">@first.Title</a>

                    <div class="mega-dropdown">

                        <div class="mega-container">

                            <!-- SECOND LEVEL -->
                            <div class="mega-columns">

                                @foreach (var second in first.Children)
                                {
                                    <div class="column">

                                        <h4>
                                            <a href="@second.URL">@second.Title</a>
                                        </h4>

                                        @if (!string.IsNullOrEmpty(second.Description))
                                        {
                                            <p class="column-desc">
                                                @second.Description
                                            </p>
                                        }

                                        <!-- THIRD LEVEL -->
                                        @if (second.Children != null && second.Children.Any())
                                        {
                                            <ul class="third-level">

                                                @foreach (var third in second.Children)
                                                {
                                                    <li>
                                                        <a href="@third.URL">
                                                            @third.Title
                                                        </a>
                                                    </li>
                                                }

                                            </ul>
                                        }

                                    </div>
                                }

                            </div>

                            <!-- FEATURED ITEMS -->
                            @if (first.Featured != null && first.Featured.Any())
                            {
                                <div class="featured-items">

                                    @foreach (var featured in first.Featured)
                                    {
                                        <div class="featured">

                                            <a href="@featured.URL">

                                                <h5>@featured.Title</h5>

                                                <p>@featured.Description</p>

                                            </a>

                                        </div>
                                    }

                                </div>
                            }

                        </div>

                    </div>

                </li>
            }

        </ul>

    </div>
}


<!-- ============================= -->
<!-- STYLES -->
<!-- ============================= -->
<style>

    .site-header {
        width: 100%;
        background: #ffffff;
        border-bottom: 1px solid #e5e5e5;
        font-family: Arial, Helvetica, sans-serif;
    }

    /* TOP MENU */

    .top-menu {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 40px;
        font-size: 14px;
    }

    .top-menu-links {
        display: flex;
        gap: 20px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .top-menu-links a {
            text-decoration: none;
            color: #333;
        }

    .top-menu-right {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .contact-btn {
        background: #e30613;
        color: #fff;
        padding: 8px 16px;
        border-radius: 4px;
        text-decoration: none;
    }

    .culture-switcher {
        display: flex;
    }

    .culture-list {
        display: flex;
        gap: 10px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .culture-list li a {
            text-decoration: none;
            color: #333;
        }

        .culture-list li:not(:last-child)::after {
            content: "|";
            margin-left: 10px;
            color: #aaa;
        }

    /* LOGO + SEARCH */

    .logo-search {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 40px;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .logo img {
            height: 40px;
        }

        .logo span {
            font-weight: bold;
            font-size: 18px;
        }

    .search-box input {
        padding: 8px 12px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    /* MEGA MENU */

    .mega-menu-wrapper {
        background: #fff;
    }

    .mega-main {
        list-style: none;
        display: flex;
        gap: 30px;
        padding: 15px 40px;
        margin: 0;
    }

    .mega-parent {
        position: relative;
    }

    .mega-dropdown {
        display: none;
        position: absolute;
        background: #fff;
        width: 100%;
        left: 0;
        top: 40px;
        border-top: 1px solid #ddd;
    }

    .mega-parent:hover .mega-dropdown {
        display: block;
    }

    .mega-container {
        padding: 40px;
    }

    .mega-columns {
        display: flex;
        gap: 40px;
    }

    .column {
        width: 200px;
    }

    .third-level {
        list-style: none;
        padding: 0;
        margin-top: 10px;
    }

        .third-level li {
            margin-bottom: 5px;
        }

    .featured-items {
        margin-top: 30px;
        display: flex;
        gap: 30px;
    }

    .featured {
        width: 250px;
    }

</style>