<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Footer Example</title>
    <style>
        /* Footer Styles */
        .site-footer {
            background: #333;
            color: white;
            font-family: Arial, Helvetica, sans-serif;
            margin-top: 40px;
            padding: 40px 0;
        }

            .site-footer .footer-container {
                max-width: 1200px;
                margin: auto;
                display: flex;
                justify-content: space-between;
                flex-wrap: wrap;
            }

            /* Left Links */
            .site-footer .footer-links {
                min-width: 250px;
            }

                .site-footer .footer-links ul {
                    list-style: none;
                    padding: 0;
                    margin: 0;
                    line-height: 2;
                }

                .site-footer .footer-links a {
                    color: white;
                    text-decoration: none;
                }

                    .site-footer .footer-links a:hover {
                        text-decoration: underline;
                    }

            /* Social + Copyright */
            .site-footer .footer-social {
                text-align: right;
                min-width: 250px;
            }

            .site-footer .social-links a {
                color: white;
                margin-right: 15px;
                text-decoration: none;
                font-weight: bold;
            }

                .site-footer .social-links a:hover {
                    text-decoration: underline;
                }

            .site-footer .footer-copy {
                font-size: 14px;
                color: #ccc;
                margin-top: 10px;
            }

        
        .site-footer .footer-social {
            text-align: left;
            margin-top: 20px;
        }

        }
    </style>
</head>
<body>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="footer-container">

            <!-- LEFT LINKS -->
            <div class="footer-links">
                <ul>
                    <li><a href="/nb-no/kontakt">Kontakt</a></li>
                    <li><a href="/nb-no/kontorer">Kontorer</a></li>
                    <li><a href="/nb-no/bcr">BCR</a></li>
                    <li><a href="/nb-no/sitemap">Sitemap</a></li>
                    <li><a href="https://www.bdo.no/nb-no/om-bdo/presse">Presserom</a></li>
                    <li><a href="https://www.bdo.no/nb-no/kundeportal">Kundeportal</a></li>
                    <li><a href="https://go.bdo.no/nyhetsbrev.html">Påmelding nyhetsbrev</a></li>
                    <li><a href="/nb-no/karriere/ledige-stillinger">Ledige stillinger</a></li>
                    <li><a href="/nb-no/personvernerklaering">Personvernerklæring</a></li>
                </ul>
            </div>

            <!-- SOCIAL + COPYRIGHT -->
            <div class="footer-social">
                <div class="social-links">
                    <a href="https://www.instagram.com/bdonorge/" target="_blank">Instagram</a>
                    <a href="https://www.facebook.com/bdonorge" target="_blank">Facebook</a>
                    <a href="https://www.linkedin.com/company/bdo-as" target="_blank">LinkedIn</a>
                    <a href="https://www.youtube.com/user/BDOnorge" target="_blank">YouTube</a>
                </div>
                <div class="footer-copy">
                    BDO Copyright © 2026. See Terms & Conditions for more information.
                </div>
            </div>

        </div>
    </footer>

</body>
</html>