@model BDO.GWT.Core.DTOs.Footer.FooterDto

<footer class="footer">

    @* ================= SUBSCRIPTION ================= *@
    @if (Model.DisplaySubscriptionsSection)
    {
        <div class="footer-subscription">
            <a href="@Model.SubscriptionButtonLink" class="btn-subscribe">
                Subscribe
            </a>
        </div>
    }

    @* ================= MAIN FOOTER ================= *@
    <div class="footer-container">

        @* LINKS *@
        <div class="footer-section">
            <h4>Quick Links</h4>
            <ul>
                @foreach (var link in Model.FooterLinks)
                {
                    <li>
                        <a href="@link.URL" target="@(link.OpenInNewTab ? "_blank" : "_self")">
                            @link.Title
                        </a>
                    </li>
                }
            </ul>
        </div>

        @* SOCIAL *@
        <div class="footer-section">
            <h4>Follow Us</h4>
            <div class="social-icons">
                    @foreach (var social in Model.SocialButtons)
                    {
                        <a href="@social.URL"
                           aria-label="@social.AriaLabel"
                           title="@social.AltText"
                           target="_blank">

                            @switch (social.IconType?.ToLower())
                            {
                                case "facebook":
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="white">
                                        <path d="M22 12a10 10 0 1 0-11.5 9.9v-7h-2v-2.9h2V9.5c0-2 1.2-3.1 3-3.1.9 0 1.8.2 1.8.2v2h-1c-1 0-1.3.6-1.3 1.2v1.5h2.3l-.4 2.9h-1.9v7A10 10 0 0 0 22 12z" />
                                    </svg>
                                    break;

                                case "instagram":
                                    <svg width="20" height="20" fill="white" viewBox="0 0 24 24">
                                        <path d="M7 2C4.2 2 2 4.2 2 7v10c0 2.8 2.2 5 5 5h10c2.8 0 5-2.2 5-5V7c0-2.8-2.2-5-5-5H7zm5 5a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm6.5-.9a1.4 1.4 0 1 1-2.8 0 1.4 1.4 0 0 1 2.8 0z" />
                                    </svg>
                                    break;

                                case "youtube":
                                    <svg width="20" height="20" fill="white" viewBox="0 0 24 24">
                                        <path d="M21.6 7.2a2.7 2.7 0 0 0-1.9-1.9C18 5 12 5 12 5s-6 0-7.7.3A2.7 2.7 0 0 0 2.4 7.2 28 28 0 0 0 2 12a28 28 0 0 0 .4 4.8 2.7 2.7 0 0 0 1.9 1.9C6 19 12 19 12 19s6 0 7.7-.3a2.7 2.7 0 0 0 1.9-1.9A28 28 0 0 0 22 12a28 28 0 0 0-.4-4.8zM10 15V9l5 3-5 3z" />
                                    </svg>
                                    break;

                                default:
                                    <span>🌐</span>
                                    break;
                            }
                        </a>
                    }
            </div>
        </div>

    </div>

</footer>

                        <style>
                           .footer {
    background: #111;
    color: #fff;
    padding: 40px 20px;
}

/* Subscription */
.footer-subscription {
    text-align: center;
    margin-bottom: 30px;
}

.btn-subscribe {
    background: #007bff;
    padding: 10px 20px;
    border-radius: 6px;
    color: #fff;
}

/* Layout */
.footer-container {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
}

/* Sections */
.footer-section {
    flex: 1;
    min-width: 200px;
}

.footer-section h4 {
    margin-bottom: 15px;
}

/* Links */
.footer-links ul,
.footer-section ul {
    list-style: none;
    padding: 0;
}

.footer-section li {
    margin-bottom: 8px;
}

/* Social */
.social-icons {
    display: flex;
    gap: 15px;
}

.social-icons a {
    font-size: 20px;
}

/* Hover */
.footer a:hover {
    color: #00bcd4;
}
                            </style>