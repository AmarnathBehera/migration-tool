@using BDO.GWT.Global.Components.ViewComponents
@using BDO.GWT.Xperience
@using CMS.Websites.Routing
@using GWTXbyKWeb.Components.ViewComponents
@using Kentico.Activities.Web.Mvc
@using Kentico.Content.Web.Mvc
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Kentico.PageBuilder.Web.Mvc
@using BDO.GWT.Core.Services
@inject IPageContext PageContext
@inject ICultureContext CultureContext
@inject IContentRetriever contentRetriever
@inject IWebsiteChannelContext websiteChannelContext

<!DOCTYPE html>
<html lang="@(CultureContext.CurrentLanguageTag)" dir="@(CultureContext.IsCurrentCultureRtl ? "rtl" : "ltr")" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    @{
        var metaDto = await PageContext.GetCurrentPageMetadataAsync();
    }

    <title>@metaDto?.MetaTitle</title>
    <meta name="description" content="@metaDto?.MetaDescription" />

    <partial name="_Favicon.cshtml" />

    <!-- ✅ Page Builder Styles (IMPORTANT FIX) -->
    @Html.Kentico().PageBuilderStyles()

    @(await Component.InvokeAsync<ScriptsHead>())
    @(await Component.InvokeAsync<StartScriptsHead>())
    @(await Component.InvokeAsync<ScriptsWhenCookiesAccepted>())
    @(await Component.InvokeAsync<MarketoMunchkincode>())
    @Html.Kentico().ActivityLoggingScriptV2()
     @RenderSection("styles", required: false)
<style>
                    .site-footer {
                        background: #333;
                        color: white;
                        font-family: Arial, Helvetica, sans-serif;
                        margin-top: 40px;
                        padding: 40px 0;
                    }

                        .site-footer .footer-container {
                            max-width: 1200px;
                            margin: auto;
                            display: flex;
                            justify-content: space-between;
                            flex-wrap: wrap;
                        }

                        .site-footer .footer-links {
                            min-width: 250px;
                        }

                            .site-footer .footer-links ul {
                                list-style: none;
                                padding: 0;
                                margin: 0;
                                line-height: 2;
                            }

                            .site-footer .footer-links a {
                                color: white;
                                text-decoration: none;
                            }

                                .site-footer .footer-links a:hover {
                                    text-decoration: underline;
                                }

                        .site-footer .footer-social {
                            text-align: left;
                            margin-top: 20px;
                            min-width: 250px;
                        }

                        .site-footer .social-links a {
                            color: white;
                            margin-right: 15px;
                            text-decoration: none;
                            font-weight: bold;
                        }

                            .site-footer .social-links a:hover {
                                text-decoration: underline;
                            }

                        .site-footer .footer-copy {
                            font-size: 14px;
                            color: #ccc;
                            margin-top: 10px;
                        }
                </style>
</head>

<body>
    @(await Component.InvokeAsync<ScriptsTopBody>())
    @(await Component.InvokeAsync<Header>())
     @RenderBody()
   @(await Component.InvokeAsync<Test>())
   @(await Component.InvokeAsync<Footer>())
   @await Html.Kentico().PageBuilderScriptsAsync()
@(await Component.InvokeAsync<ScriptsBottomBody>())
</body>
</html>