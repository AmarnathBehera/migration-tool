@inject IPageBuilderService PageBuilderService
@using BDO
@using BDO.GWT.Core.Services
@model BDO.GWT.Core.DTOs.Pages.MicrositePageDto;

@section HeadHtml {
    @(Model.HeadHtml is not null ? Html.Raw(Model.HeadHtml) : null)
}

@section CustomJS {
    @foreach (var js in Model.CustomJsLinks)
    {
        <script type="text/javascript" src="@Html.Raw(js)"></script>
    }
}

@section CustomCSS {
    @foreach (var css in Model.CustomCssLinks)
    {
        <link href="@Html.Raw(css)" type='text/css' rel='stylesheet'>
    }
}

@section BodyTopHtml {
    @(Model.BodyTopHtml is not null ? Html.Raw(Model.BodyTopHtml) : null)
}

@section BodyBottomHtml {
    @(Model.BodyBottomHtml is not null ? Html.Raw(Model.BodyBottomHtml) : null)
}


@{
    Layout = "_MicrositeLayout";

    var widgetsList = new[]
    {
        ComponentIdentifiers.Widgets.ExternalNavigation,
        ComponentIdentifiers.Widgets.Imagewithtext,
        ComponentIdentifiers.Widgets.QuoteCard,
        ComponentIdentifiers.Widgets.TiledLink,
        ComponentIdentifiers.Widgets.RichText,
        ComponentIdentifiers.Widgets.Globallocation,
        ComponentIdentifiers.Widgets.AccordionWidget,
        ComponentIdentifiers.Widgets.FaqWidget,
        ComponentIdentifiers.Widgets.FlexibleBanner,
        ComponentIdentifiers.Widgets.FlexibleContent,
        ComponentIdentifiers.Widgets.KeyContacts

    };
}

@section Styles {
    @PageBuilderService.GetPageBuilderStyles(Html)
}
<div>
    @await Html.Kentico().EditableAreaAsync(
        "mainContent",
        new EditableAreaOptions
        {
            AllowedWidgets = widgetsList
        })
</div>
@PageBuilderService.GetPageBuilderScripts(Html)
