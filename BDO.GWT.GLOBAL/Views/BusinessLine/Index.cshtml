@using BDO
@using BDO.GWT.Core.Constants
@using BDO.GWT.Core.Services
@using Kentico.Content.Web.Mvc
@model (BDO.GWT.Core.DTOs.BusinessLinePageDto BusinessLinePageDto, BDO.GWT.Core.DTOs.SchemaMarkups.ServiceSchemaMarkupDto ServiceSchemaMarkupDto)


@inject IReactService ReactService
@inject IWebPageDataContextRetriever WebPageDataContextRetriever

@{
    var pageContext = WebPageDataContextRetriever.Retrieve();
    var pageId = pageContext.WebPage.WebPageItemID;
}
@section SchemaMarkup {
    @Html.Raw(this.Model.ServiceSchemaMarkupDto.ToSchemaMarkupJsString())
}
@{
    Layout = "_Layout";

    var widgetsList = new[]
    {
        ComponentIdentifiers.Widgets.ExternalNavigation,
        ComponentIdentifiers.Widgets.Imagewithtext,
        ComponentIdentifiers.Widgets.QuoteCard,
        ComponentIdentifiers.Widgets.TiledLink,
        ComponentIdentifiers.Widgets.RichText,
        ComponentIdentifiers.Widgets.Globallocation,
        ComponentIdentifiers.Widgets.AccordionWidget,
        ComponentIdentifiers.Widgets.FaqWidget
    };
}
@{
    var isSideBoxVisible = Model.BusinessLinePageDto.Sidebox != null && Model.BusinessLinePageDto.ShowSideNavigation;
}

<div>
    @(await ReactService.RenderComponentAsync(
        pageId,
        ReactComponentType.Hero,
        ReactComponentType.HeroGUID,
        new
        {
            data = Model.BusinessLinePageDto.Hero,
        },
        Context.RequestAborted))
</div>

<div class="service-wrapper">
    <div class="@($"service-wrapper-content{(isSideBoxVisible ? "" : " service-wrapper-content--full")}")">
        <main>
            @(await ReactService.RenderComponentAsync(
                        pageId,
                        ReactComponentType.ServiceContent,
                        ReactComponentType.ServiceContentGUID,
                        Model,
                        Context.RequestAborted))
            @* @await PageBuilderService.AddIdentifier("topArea").AddDefaultWidgets().AddWidgets(widgetsList).AddAdvancedWidgets(advancedWidgetsList).BuildEditableAreaAsync(Html) *@
        </main>
        @if (isSideBoxVisible)
        {
            <aside>
                @(await ReactService.RenderComponentAsync(
                            pageId,
                            ReactComponentType.SideBoxNavigation,
                            ReactComponentType.SideBoxNavigationGUID,
                            Model.BusinessLinePageDto.Sidebox,
                            Context.RequestAborted))
            </aside>
        }
    </div>
    @*  @await PageBuilderService.AddIdentifier("bottomArea").AddDefaultWidgets().AddWidgets(widgetsList).AddAdvancedWidgets(advancedWidgetsList).BuildEditableAreaAsync(Html) *@
</div>
<div>
    @await Html.Kentico().EditableAreaAsync(
        "mainContent",
        new EditableAreaOptions
        {
            AllowedWidgets = widgetsList
        })
</div>