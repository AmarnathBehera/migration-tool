@model BDO.GWT.Web.Core.DTOs.CareerPageDto

@using BDO
@using BDO.GWT.Core.Constants;
@using BDO.GWT.Core.Services
@using Kentico.Content.Web.Mvc

@inject IReactService ReactService
@inject IWebPageDataContextRetriever WebPageDataContextRetriever

@{
    var pageContext = WebPageDataContextRetriever.Retrieve();
    var pageId = pageContext.WebPage.WebPageItemID;
}


@{
    var widgetsList = new[]
    {
        ComponentIdentifiers.Widgets.AccordionWidget,
        //ComponentIdentifiers.Widgets.BannerWithIcons,
        //ComponentIdentifiers.Widgets.CommunityInvolvement,
        //ComponentIdentifiers.Widgets.DescriptionText,

        // widgets_not_there_yet:

        // ComponentIdentifiers.Widgets.EditorsPick,
        // ComponentIdentifiers.Widgets.Faq,
        // ComponentIdentifiers.Widgets.Imagewithtext,
        // ComponentIdentifiers.Widgets.InFocus,
        // ComponentIdentifiers.Widgets.KeyContacts,
        // ---------


        //ComponentIdentifiers.Widgets.PurposeIcon,
        //ComponentIdentifiers.Widgets.TwitterCarousel,
        ComponentIdentifiers.Widgets.Globallocation,
    };
}

@* @section Styles {
    @PageBuilderService.GetPageBuilderStyles(Html)
} *@

<div>
    @(await ReactService.RenderComponentAsync(
        pageId,
        ReactComponentType.Hero,
        ReactComponentType.HeroGUID,
        new
        {
            data = Model.Hero,
        },
        Context.RequestAborted))
</div>
@Model.Content.EmploymentType
@Model.Content.JobTitle
@Model.Content.Content
@Model.Content.Level
@Model.Content.Title

@* 
@await Html.PartialAsync("_LocalNavigation") *@
<section class="career-details-section">
    <article class="career-details-wrapper">
        <div class="@($"career-details-container{(Model.Sidebar != null ? "" : "--no-sidebar")}")">
            @(await ReactService.RenderComponentAsync(
                        pageId,
                        ReactComponentType.CareerDetails,
                        ReactComponentType.CareerDetailsGUID,
                        new
                        {
                            data = Model.Content,
                        },
                        Context.RequestAborted))

                        
            @if (!string.IsNullOrEmpty(Model.Form))
            {
                <div class="career-form-container">
                    @* @await FormBuilder.GetFormBuilderWidget(Html, Model.Form) *@
                </div>
            }
        </div>
        @if (Model.Sidebar != null)
        {
            <div>
            @(await ReactService.RenderComponentAsync(
                    pageId,
                    "CareerSidebar",
                    ReactComponentType.CareerSidebarGUID,
                    new
                    {
                        data = Model.Sidebar,
                    },
                    Context.RequestAborted))
            </div>
        }
    </article>
</section>




@await Html.Kentico().EditableAreaAsync(
"mainContent", // Unique identifier
                        new EditableAreaOptions
                        {

                            AllowedWidgets = widgetsList
                        })


