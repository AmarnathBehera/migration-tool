@using BDO
@using BDO.GWT.Core.Constants
@using BDO.GWT.Core.Services
@using Kentico.Content.Web.Mvc
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery

@inject IReactService ReactService
@inject IWebPageDataContextRetriever WebPageDataContextRetriever
@inject IPageBuilderService PageBuilderService

@{
    var pageContext = WebPageDataContextRetriever.Retrieve();
    var pageId = pageContext.WebPage.WebPageItemID;
}
@{
    var widgetsList = new[]
    {
        ComponentIdentifiers.Widgets.Button,
        ComponentIdentifiers.Widgets.FlexibleBanner,
        ComponentIdentifiers.Widgets.Form,
        ComponentIdentifiers.Widgets.RichText,
        ComponentIdentifiers.Widgets.ViewGlobalLocations,
    };
}
@(await ReactService.RenderComponentAsync(
    pageId,
    ReactComponentType.Hero,
    ReactComponentType.HeroGUID,
    new { data = Model.Hero },
    Context.RequestAborted))

<div class="section-container section-container--items section-container--two-thirds gap--xl py-20">
    <div class="contact-form-container">

        @if (Model.FormType is "embedCode")
        {
            @Html.Raw(Model.EmbedCode)
        }
        @if (Model.FormType is "form")
        {
            <input id="RequestVerificationToken" type="hidden" value="@Antiforgery.GetAndStoreTokens(Context).RequestToken"/>
            @(await ReactService.RenderComponentAsync(
                    pageId,
                    ReactComponentType.SubscribeForm,
                    ReactComponentType.SubscribeFormGUID,
                    Model.SubscribeFormDto,
                    Context.RequestAborted))
        }        
    </div>
    <div>
        @await PageBuilderService.AddIdentifier("topArea").AddWidgets(widgetsList).BuildEditableAreaAsync(Html,Context.RequestAborted)
    </div>
</div>

@await PageBuilderService.AddIdentifier("bottomArea").AddWidgets(widgetsList).BuildEditableAreaAsync(Html,Context.RequestAborted)


